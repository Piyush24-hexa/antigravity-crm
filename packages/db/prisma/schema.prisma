// This is your Prisma schema file
// Full Antigravity CRM data model

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, uuid_ossp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════
// WORKSPACE & USERS
// ═══════════════════════════════════════

model Workspace {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  plan             String   @default("free") @db.VarChar(50)
  stripeCustomerId String?  @map("stripe_customer_id") @db.VarChar(255)
  stripeSubId      String?  @map("stripe_sub_id") @db.VarChar(255)
  seatsUsed        Int      @default(1) @map("seats_used")
  seatsLimit       Int      @default(1) @map("seats_limit")
  aiTokensUsed     BigInt   @default(0) @map("ai_tokens_used")
  aiTokensLimit    BigInt   @default(100000) @map("ai_tokens_limit")
  dataRegion       String   @default("us") @map("data_region") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  users        User[]
  contacts     Contact[]
  companies    Company[]
  pipelines    Pipeline[]
  stages       Stage[]
  deals        Deal[]
  activities   Activity[]
  emails       Email[]
  sequences    Sequence[]
  automations  Automation[]
  forecasts    Forecast[]
  aiUsage      AiUsage[]
  integrations Integration[]

  products        Product[]
  priceBooks      PriceBook[]
  priceBookEntries PriceBookEntry[]
  quotes          Quote[]
  quoteLineItems  QuoteLineItem[]
  dealContacts    DealContact[]
  campaigns       Campaign[]
  campaignMembers CampaignMember[]
  auditLogs       AuditLog[]
  dealStageHistory DealStageHistory[]
  quotas          Quota[]
  @@map("workspaces")
}

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  clerkUserId  String    @unique @map("clerk_user_id") @db.VarChar(255)
  email        String    @db.VarChar(255)
  name         String?   @db.VarChar(255)
  role         String    @default("member") @db.VarChar(50)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts   Contact[]  @relation("ContactOwner")
  deals      Deal[]     @relation("DealOwner")
  activities Activity[]
  emails     Email[]
  sequences  Sequence[] @relation("SequenceCreator")
  automations Automation[] @relation("AutomationCreator")
  aiUsage    AiUsage[]

  @@index([workspaceId])
  @@map("users")
}

// ═══════════════════════════════════════
// CONTACTS & COMPANIES
// ═══════════════════════════════════════

model Contact {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  mobile            String?   @db.VarChar(50)
  firstName         String?   @map("first_name") @db.VarChar(255)
  lastName          String?   @map("last_name") @db.VarChar(255)
  title             String?   @db.VarChar(255)
  department        String?   @db.VarChar(255)
  linkedin          String?   @db.VarChar(255)
  twitter           String?   @db.VarChar(255)
  street            String?   @db.VarChar(500)
  city              String?   @db.VarChar(100)
  state             String?   @db.VarChar(100)
  zip               String?   @db.VarChar(50)
  country           String?   @db.VarChar(100)
  doNotCall         Boolean   @default(false) @map("do_not_call")
  emailOptOut       Boolean   @default(false) @map("email_opt_out")
  companyId         String?   @map("company_id") @db.Uuid
  ownerId           String?   @map("owner_id") @db.Uuid
  leadScore         Int       @default(0) @map("lead_score")
  relationshipScore Int       @default(0) @map("relationship_score")
  status            String    @default("lead") @db.VarChar(50)
  source            String?   @db.VarChar(100)
  tags              String[]  @db.VarChar(255)
  customFields      Json      @default("{}") @map("custom_fields") @db.JsonB
  enrichedAt        DateTime? @map("enriched_at") @db.Timestamptz()
  embedding         Unsupported("vector(1536)")?
  gdprDeleted       Boolean   @default(false) @map("gdpr_deleted")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id])
  owner      User?      @relation("ContactOwner", fields: [ownerId], references: [id])
  deals      Deal[]
  activities Activity[]
  emails     Email[]

  campaigns       CampaignMember[]
  dealRoles       DealContact[]
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@map("contacts")
}
model Company {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  name               String   @db.VarChar(255)
  legalName          String?  @map("legal_name") @db.VarChar(255)
  domain             String?  @db.VarChar(255)
  industry           String?  @db.VarChar(100)
  size               String?  @db.VarChar(50)
  revenue            BigInt?
  
  // Enterprise Legal & Financial
  taxId              String?  @map("tax_id") @db.VarChar(100)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  companyType        String?  @map("company_type") @db.VarChar(50)
  currency           String   @default("USD") @db.VarChar(3)
  paymentTerms       String?  @map("payment_terms") @db.VarChar(50)
  creditLimit        Decimal? @map("credit_limit") @db.Decimal(15, 2)
  
  // Contact Info
  phone              String?  @db.VarChar(50)
  email              String?  @db.VarChar(255)
  
  // Billing Address
  billingStreet      String?  @map("billing_street") @db.VarChar(500)
  billingCity        String?  @map("billing_city") @db.VarChar(100)
  billingState       String?  @map("billing_state") @db.VarChar(100)
  billingZip         String?  @map("billing_zip") @db.VarChar(50)
  billingCountry     String?  @map("billing_country") @db.VarChar(100)
  
  // Shipping Address
  shippingStreet     String?  @map("shipping_street") @db.VarChar(500)
  shippingCity       String?  @map("shipping_city") @db.VarChar(100)
  shippingState      String?  @map("shipping_state") @db.VarChar(100)
  shippingZip        String?  @map("shipping_zip") @db.VarChar(50)
  shippingCountry    String?  @map("shipping_country") @db.VarChar(100)

  // Legacy (Keep for backwards compatibility with demo data)
  country            String?  @db.VarChar(100)
  
  techStack          String[] @map("tech_stack") @db.VarChar(100)
  parentCompanyId    String?  @map("parent_company_id") @db.Uuid
  parentCompany      Company? @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies     Company[] @relation("CompanyHierarchy")
  customFields       Json     @default("{}") @map("custom_fields") @db.JsonB
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  deals     Deal[]
  activities Activity[]

  @@index([workspaceId])
  @@map("companies")
}

// ═══════════════════════════════════════
// PIPELINE & DEALS
// ═══════════════════════════════════════

model Pipeline {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]

  @@index([workspaceId])
  @@map("pipelines")
}

model Stage {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String   @db.VarChar(255)
  displayOrder   Int      @map("display_order")
  winProbability Float    @default(0) @map("win_probability")
  color          String?  @db.VarChar(7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([pipelineId])
  @@index([workspaceId])
  @@map("stages")
}

model Deal {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  title           String    @db.VarChar(255)
  dealType        String?   @map("deal_type") @db.VarChar(50)
  priority        String?   @db.VarChar(50)
  source          String?   @db.VarChar(100)
  contactId       String?   @map("contact_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  ownerId         String?   @map("owner_id") @db.Uuid
  value           Decimal?  @db.Decimal(15, 2)
  currency        String    @default("USD") @db.VarChar(3)
  billingFrequency String?  @map("billing_frequency") @db.VarChar(50)
  closeDate       DateTime? @map("close_date") @db.Date
  winProbability  Float?    @map("win_probability")
  status          String    @default("open") @db.VarChar(50)
  lostReason      String?   @map("lost_reason") @db.VarChar(255)
  competitors     String[]  @db.VarChar(100)
  nextStep        String?   @map("next_step") @db.VarChar(500)
  nextStepDate    DateTime? @map("next_step_date") @db.Timestamptz()
  customFields    Json      @default("{}") @map("custom_fields") @db.JsonB
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz()
  stalledAt       DateTime? @map("stalled_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id])
  company    Company?   @relation(fields: [companyId], references: [id])
  stage      Stage      @relation(fields: [stageId], references: [id])
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id])
  activities Activity[]
  emails     Email[]

  forecastCategory String?  @map("forecast_category") @db.VarChar(50)
  managerOverride  Decimal? @map("manager_override") @db.Decimal(15, 2)
  overrideNote     String?  @map("override_note") @db.Text

  dealContacts    DealContact[]
  quotes          Quote[]
  stageHistory    DealStageHistory[]

  @@index([workspaceId, stageId])
  @@index([workspaceId, ownerId])
  @@map("deals")
}

// ═══════════════════════════════════════
// ACTIVITIES & EMAILS
// ═══════════════════════════════════════

model Activity {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  contactId             String?   @map("contact_id") @db.Uuid
  dealId                String?   @map("deal_id") @db.Uuid
  companyId             String?   @map("company_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  type                  String    @db.VarChar(50)
  direction             String?   @db.VarChar(10)
  subject               String?   @db.VarChar(255)
  body                  String?   @db.Text
  summary               String?   @db.Text
  sentiment             String?   @db.VarChar(20)
  actionItems           Json?     @map("action_items") @db.JsonB
  competitorsMentioned  String[]  @map("competitors_mentioned") @db.VarChar(100)
  durationSeconds       Int?      @map("duration_seconds")
  startTime             DateTime? @map("start_time") @db.Timestamptz()
  endTime               DateTime? @map("end_time") @db.Timestamptz()
  status                String?   @db.VarChar(50)
  mediaUrls             String[]  @map("media_urls") @db.VarChar(500)
  recordingUrl          String?   @map("recording_url") @db.VarChar(500)
  transcript            String?   @db.Text
  scheduledAt           DateTime? @map("scheduled_at") @db.Timestamptz()
  completedAt           DateTime? @map("completed_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  assigneeId            String?   @map("assignee_id") @db.Uuid
  dueDate               DateTime? @map("due_date") @db.Timestamptz()
  taskStatus            String?   @map("task_status") @db.VarChar(50)
  reminderAt            DateTime? @map("reminder_at") @db.Timestamptz()
  priority              String?   @db.VarChar(50)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
  deal      Deal?     @relation(fields: [dealId], references: [id])
  company   Company?  @relation(fields: [companyId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("activities")
}

model Email {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  threadId       String?   @map("thread_id") @db.VarChar(255)
  messageId      String?   @unique @map("message_id") @db.VarChar(255)
  contactId      String?   @map("contact_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  direction      String    @db.VarChar(10)
  fromEmail      String?   @map("from_email") @db.VarChar(255)
  toEmails       String[]  @map("to_emails") @db.VarChar(255)
  subject        String?   @db.VarChar(500)
  bodyText       String?   @map("body_text") @db.Text
  bodyHtml       String?   @map("body_html") @db.Text
  sentiment      String?   @db.VarChar(20)
  classification String?   @db.VarChar(50)
  urgencyScore   Int?      @map("urgency_score")
  openedAt       DateTime? @map("opened_at") @db.Timestamptz()
  repliedAt      DateTime? @map("replied_at") @db.Timestamptz()
  sequenceId     String?   @map("sequence_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
  deal      Deal?     @relation(fields: [dealId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
  sequence  Sequence? @relation(fields: [sequenceId], references: [id])

  @@index([workspaceId, threadId])
  @@map("emails")
}

// ═══════════════════════════════════════
// SEQUENCES
// ═══════════════════════════════════════

model Sequence {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  status      String   @default("draft") @db.VarChar(50)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?          @relation("SequenceCreator", fields: [createdBy], references: [id])
  steps     SequenceStep[]
  emails    Email[]

  @@index([workspaceId])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sequenceId String   @map("sequence_id") @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  stepOrder  Int      @map("step_order")
  delayDays  Int      @default(0) @map("delay_days")
  subject    String?  @db.VarChar(500)
  bodyHtml   String?  @map("body_html") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("sequence_steps")
}

// ═══════════════════════════════════════
// AUTOMATIONS
// ═══════════════════════════════════════

model Automation {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String?   @db.VarChar(255)
  triggerJson Json      @map("trigger_json") @db.JsonB
  actionsJson Json      @map("actions_json") @db.JsonB
  active      Boolean   @default(false)
  runCount    Int       @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz()
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("AutomationCreator", fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@map("automations")
}

// ═══════════════════════════════════════
// FORECASTS & AI USAGE
// ═══════════════════════════════════════

model Forecast {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  predictedRevenue Decimal? @map("predicted_revenue") @db.Decimal(15, 2)
  confidenceLower  Decimal? @map("confidence_lower") @db.Decimal(15, 2)
  confidenceUpper  Decimal? @map("confidence_upper") @db.Decimal(15, 2)
  actualRevenue    Decimal? @map("actual_revenue") @db.Decimal(15, 2)
  modelVersion     String?  @map("model_version") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("forecasts")
}

model AiUsage {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  model        String   @db.VarChar(100)
  feature      String   @db.VarChar(100)
  tokensIn     Int      @default(0) @map("tokens_in")
  tokensOut    Int      @default(0) @map("tokens_out")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  latencyMs    Int?     @map("latency_ms")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("ai_usage")
}

// ═══════════════════════════════════════
// INTEGRATIONS
// ═══════════════════════════════════════

model Integration {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  provider      String    @db.VarChar(50)
  accessToken   String?   @map("access_token") @db.Text
  refreshToken  String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz()
  metadata      Json      @default("{}") @db.JsonB
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("integrations")
}

// ═══════════════════════════════════════
// FAILED JOBS (Dead Letter)
// ═══════════════════════════════════════

model FailedJob {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  queue       String   @db.VarChar(100)
  jobId       String   @map("job_id") @db.VarChar(255)
  jobData     Json     @map("job_data") @db.JsonB
  error       String   @db.Text
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([workspaceId])
  @@map("failed_jobs")
}


// ---------------------------------------
// SPRINT 1 ENTERPRISE UPGRADES
// ---------------------------------------

model Product {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  sku         String?  @db.VarChar(100)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceBooks  PriceBookEntry[]

  @@index([workspaceId])
  @@map("products")
}

model PriceBook {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  isStandard  Boolean  @default(false) @map("is_standard")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   PriceBookEntry[]

  @@index([workspaceId])
  @@map("price_books")
}

model PriceBookEntry {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  priceBookId String   @map("price_book_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  currency    String   @default("USD") @db.VarChar(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceBook   PriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quoteLines  QuoteLineItem[]

  @@index([workspaceId])
  @@unique([priceBookId, productId])
  @@map("price_book_entries")
}

model Quote {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  dealId      String   @map("deal_id") @db.Uuid
  quoteNumber String   @map("quote_number") @db.VarChar(100)
  status      String   @default("Draft") @db.VarChar(50)
  validUntil  DateTime? @map("valid_until") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lineItems  QuoteLineItem[]

  @@index([workspaceId, dealId])
  @@map("quotes")
}

